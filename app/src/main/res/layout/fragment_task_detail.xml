<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/task_detail_background_pink"
    tools:context=".ui.fragments.TaskDetailFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_task_detail_header"
            android:padding="20dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/textTaskDetailHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/task_detail_header"
                android:textAlignment="center"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textTaskDetailSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/task_detail_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:background="@drawable/bg_task_detail_card"
            android:padding="20dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/labelTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/task_detail_label_title"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/containerTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:startIconDrawable="@drawable/ic_task_title"
                app:startIconTint="@color/task_detail_accent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputTaskTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/task_detail_hint_title"
                    android:imeOptions="actionNext"
                    android:inputType="textCapSentences"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/labelDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/task_detail_label_description"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/containerTaskDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:startIconDrawable="@drawable/ic_task_description"
                app:startIconTint="@color/task_detail_accent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputTaskDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/task_detail_hint_description"
                    android:inputType="textMultiLine"
                    android:maxLines="4"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/labelDueDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/task_detail_label_due_date"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/containerTaskDueDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconMode="custom"
                app:endIconTint="@color/task_detail_accent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputTaskDueDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="@string/task_detail_hint_due_date"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:background="@drawable/bg_task_detail_card"
            android:padding="20dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/labelNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/task_detail_label_notes"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/containerTaskNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:startIconDrawable="@drawable/ic_notes"
                app:startIconTint="@color/task_detail_accent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputTaskNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/task_detail_hint_notes"
                    android:inputType="textMultiLine"
                    android:maxLines="6"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:background="@drawable/bg_task_detail_card"
            android:padding="20dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/labelAttachment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/task_detail_label_attachment"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/containerAttachment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_task_detail_attachment"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/task_detail_attachment_content_description"
                    android:src="@drawable/ic_attachment" />

                <TextView
                    android:id="@+id/textAttachmentName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/task_detail_attachment_empty"
                    android:textColor="@color/text_secondary" />

                <ImageButton
                    android:id="@+id/buttonAttachmentAction"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_task_detail_icon_button"
                    android:contentDescription="@string/task_detail_action_attachment"
                    android:src="@drawable/ic_open_gallery" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:background="@drawable/bg_task_detail_card"
            android:padding="20dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/labelVoiceNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/task_detail_label_voice_note"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/containerVoiceNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:minHeight="56dp">

                <ImageButton
                    android:id="@+id/buttonVoiceNote"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_task_detail_icon_button"
                    android:contentDescription="@string/task_detail_voice_note_content_description"
                    android:src="@drawable/ic_mic" />

                <ProgressBar
                    android:id="@+id/progressVoiceNote"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_task_detail_progress" />

                <TextView
                    android:id="@+id/textVoiceNoteDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/task_detail_voice_note_initial"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttonBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="3">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:text="@string/task_detail_button_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:text="@string/task_detail_button_save"
                app:backgroundTint="@color/task_detail_accent"
                app:cornerRadius="20dp"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonExportCalendar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/task_detail_button_calendar" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>